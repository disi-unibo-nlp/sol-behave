# === Secrets ===
.env

# Only the canonical copy lives at src/push_artifacts_to_hf.py — any
# duplicate pasted into a subfolder during iteration is ignored.
src/*/push_artifacts_to_hf.py

# === Root-level scratch/build ===
.cache/
node_modules/
models/
local_models/
llamacpp/
outputs/
dcr_generation_logs/
generation_logs/
repair_logs/
*.log

# Working notes — internal SSH host/paths/decision trail, not for public repo
handoff.md

# === src/coverage_analysis — confirmed legacy/superseded by evaluation/coverage/ ===
src/coverage_analysis/

# === src/dataset — keep code, drop data + scratch ===
src/dataset/contracts_dataset_1to20/
src/dataset/contracts_dataset_pass_08/
src/dataset/hardhat_workspace_crawl/
src/dataset/hardhat_workspace_replay/
src/dataset/.hf_stage/

# === src/dcr_generation — keep code, drop generated data + scratch ===
src/dcr_generation/generated_dcr_1to20_*/
src/dcr_generation/dcr_example/
src/dcr_generation/running_example_OHMI/
src/dcr_generation/relation_stats*.json
src/dcr_generation/drain_stats_gemma.json
src/dcr_generation/*.temp
src/dcr_generation/seq_gen.log

# === src/dcr_replay — mixed data/code, filenames drift across reruns;
# allowlist code extensions rather than enumerate data by name ===
src/dcr_replay/*
!src/dcr_replay/*.py
!src/dcr_replay/*.sh

# === src/differential_fuzzying — drop huge data, keep code ===
src/differential_fuzzying/*
!src/differential_fuzzying/*.py

# === src/evaluation — small + frozen, kept in-repo; .bak/.log/pycache always ===
src/evaluation/*.bak
src/evaluation/final_tables.log

# === src/human_eval — original xlsx has creator/email metadata, never commit ===
src/human_eval/HumanEval.xlsx
src/human_eval/HumanEval_clean.xlsx
src/human_eval/metrics_summary.csv
src/human_eval/dcr_annotation/

# === src/source_generation — keep code, drop data + scratch ===
src/source_generation/*
!src/source_generation/*.py

# === src/transaction_replay — same drift problem as dcr_replay ===
src/transaction_replay/*
!src/transaction_replay/*.py
!src/transaction_replay/*.sh

# === Everywhere ===
__pycache__/
*.pyc
.hf_stage/
hf_dry.log